<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Mono.LLM.Agent.Harness</RootNamespace>
    <AssemblyName>Mono.LLM.Agent.Harness</AssemblyName>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mono.LLM.Agent\Mono.LLM.Agent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 示例技能随程序发布，保证在任意工作目录下都能直接演示文件加载 -->
    <Content Include="skills\**\*.skill.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
